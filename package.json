{
  "name": "yurst-workspace",
  "description": "Workspace for the Yurst Yurba bot library",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter yarix start",
    "dev": "pnpm --filter yarix dev",
    "dev:logs": "pnpm --filter yarix dev:logs",
    "test": "pnpm --filter yurst.js test",
    "test:coverage": "pnpm --filter yurst.js test:coverage",

    "docs:dev": "pnpm --filter docs dev",
    "docs:run": "pnpm --filter docs run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
